; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="yggdrasil-godot"
config/description="Cliente Godot 4 do Yggdrasil — lobby 2D com 5 jogos: Snake, Tetris, Invaders, PointSet e Poker."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/autoloads/signal_bus.gd"
ApiClient="*res://scripts/autoloads/api_client.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

