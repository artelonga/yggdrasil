/target
**/*.rs.bk
.DS_Store
.env
.env.local
node_modules/
dist/
.idea/
.vscode/
*.swp
*.swo

# co-auto runtime state
/.co/index.bin

# Playwright: gravações temporárias do gerador de GIFs do Mundo (YG-150).
# Os GIFs finais (docs/mundo/*.gif) são versionados; os .webm intermediários não.
/e2e/.videos/
/e2e/test-results/

# Build artifacts
/yggdrasil-web/static/dist/

# WASM universo artifacts — built by build-universes.sh (YG-61).
# Stub files generated by build.rs when absent; real artifacts are gitignored.
/yggdrasil-web/embedded/*.wasm

# Godot Web export bundle (build via scripts/build-anatomy-web.sh)
yggdrasil-web/static/anatomia/

# Neuro atlas (Precomputed) — build via scripts/build-neuro-atlas.sh
yggdrasil-web/static/neuro-data/
.neuro-venv/
